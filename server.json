{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.zkp2p/peer-cli",
  "description": "Agent-first MCP server for the Peer protocol and custody-separated Peer Cash flows",
  "repository": {
    "url": "https://github.com/zkp2p/peer-cli",
    "source": "github"
  },
  "version": "0.1.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "peer-protocol-cli",
      "version": "0.1.0",
      "packageArguments": [
        { "type": "positional", "value": "mcp" },
        { "type": "positional", "value": "--profile" },
        { "type": "positional", "value": "cash" }
      ],
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "description": "Peer environment: production, preproduction, or staging",
          "isRequired": false,
          "format": "string",
          "isSecret": false,
          "name": "PEER_ENV"
        },
        {
          "description": "Custom Base RPC URL for reads and receipt finalization",
          "isRequired": false,
          "format": "string",
          "isSecret": true,
          "name": "PEER_CASH_RPC_URL"
        },
        {
          "description": "Curator API key when the selected environment requires one",
          "isRequired": false,
          "format": "string",
          "isSecret": true,
          "name": "PEER_CASH_API_KEY"
        },
        {
          "description": "Six-character Peer integration referral code",
          "isRequired": false,
          "format": "string",
          "isSecret": false,
          "name": "PEER_CASH_REFERRAL_CODE"
        },
        {
          "description": "Analytics-only ERC-8021 attribution code",
          "isRequired": false,
          "format": "string",
          "isSecret": false,
          "name": "PEER_CASH_REFERRER"
        }
      ]
    }
  ]
}
