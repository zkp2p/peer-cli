{
  "name": "@peer/cli",
  "version": "0.1.0",
  "description": "CLI for AI agents to interact with the Peer (ZKP2P) protocol",
  "bin": {
    "peer": "./dist/cli.cjs"
  },
  "type": "module",
  "files": [
    "dist",
    "agents",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "AGENTS.md",
    "CLAUDE.md",
    "llms.txt"
  ],
  "scripts": {
    "prebuild": "tsx scripts/generate-catalogs.ts",
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run tests/e2e/",
    "lint": "eslint src/ tests/ scripts/ --no-error-on-unmatched-pattern",
    "typecheck": "tsc --noEmit",
    "docs:dev": "npm --prefix docs run dev",
    "docs:build": "npm --prefix docs run build",
    "docs:lint": "npm --prefix docs run lint",
    "docs:typecheck": "npm --prefix docs run types:check"
  },
  "keywords": [
    "peer",
    "zkp2p",
    "cli",
    "agent",
    "mcp",
    "fiat",
    "crypto",
    "usdc"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zkp2p/peer-cli"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.28.0",
    "@zkp2p/sdk": "^0.2.3",
    "commander": "^14.0.1",
    "viem": "^2.38.2",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.36.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
