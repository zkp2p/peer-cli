{
  "name": "peer-protocol-cli",
  "version": "0.3.0",
  "description": "Agent-first CLI and MCP server for the Peer (ZKP2P) protocol and Peer Cash",
  "bin": {
    "peer": "dist/cli.cjs"
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "types": "./dist/index.d.cts",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    },
    "./agents/*": "./agents/*"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "agents",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "AGENTS.md",
    "CLAUDE.md",
    "llms.txt",
    "mcp.json",
    "plugin.json",
    "server.json",
    "skills"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "tsx scripts/generate-catalogs.ts",
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.cjs mcp --transport http --profile read-only --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run tests/e2e/",
    "lint": "eslint src/ tests/ scripts/ --no-error-on-unmatched-pattern",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "audit": "npm audit --omit=dev",
    "prepare": "npm run build",
    "prepack": "npm run check"
  },
  "keywords": [
    "peer",
    "zkp2p",
    "cli",
    "agent",
    "mcp",
    "peer-cash",
    "offramp",
    "fiat",
    "crypto",
    "usdc"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zkp2p/peer-cli.git"
  },
  "bugs": {
    "url": "https://github.com/zkp2p/peer-cli/issues"
  },
  "homepage": "https://agents.peer.xyz",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@zkp2p/cash": "^0.4.10",
    "@zkp2p/sdk": "^0.12.1",
    "commander": "^14.0.3",
    "viem": "^2.55.19",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.5.2",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.36.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
